          <mxGeometry height="52" width="52" x="1360" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#232F3E;fontSize=11;align=center;" value="Fresha&lt;br&gt;public booking pages: real availability&lt;br&gt;(no login); internal dashboard API with&lt;br&gt;the owner&#39;s stored session: book, cancel,&lt;br&gt;create client, patch-test status" vertex="1">
          <mxGeometry height="100" width="200" x="1360" y="300" as="geometry" />
