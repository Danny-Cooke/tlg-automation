  <diagram name="Bot workflow and personas" id="J_Uj_f6QDbkeq4W23-4q">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1760" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#232F3E;" value="One DM through the bot, and the three shapes Jess&#39;s voice takes" vertex="1">
          <mxGeometry height="32" width="1200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;" value="Left: what src/bot/handler.py does with each message. Right: the persona rules from persona/jess.md that decide who answers and in what register. Grey boxes end with the bot saying nothing. State as of 2026-11-08." vertex="1">
          <mxGeometry height="20" width="1500" x="40" y="54" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="A client messages the Page on Messenger or Instagram. Meta POSTs the event to the webhook within a second." vertex="1">
          <mxGeometry height="56" width="300" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Check the app signature, parse the events, load the thread from DynamoDB (last turns, who has it)." vertex="1">
          <mxGeometry height="56" width="300" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Message id already seen?&lt;br&gt;(Meta retry)" vertex="1">
          <mxGeometry height="70" width="300" x="60" y="280" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#545B64;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Drop it." vertex="1">
          <mxGeometry height="40" width="250" x="420" y="295" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Sender on the staff list, or test mode without the trigger word?" vertex="1">
          <mxGeometry height="90" width="300" x="60" y="384" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#545B64;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Store the message, say nothing. Staff messaging the Page as themselves are never answered." vertex="1">
          <mxGeometry height="56" width="250" x="420" y="401" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Thread locked to Jess?" vertex="1">
          <mxGeometry height="70" width="300" x="60" y="508" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#545B64;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Jess has it. Store the message, stay quiet until she clears the lock." vertex="1">
          <mxGeometry height="56" width="250" x="420" y="515" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Mark the message seen (a retry during the call is now a duplicate), show the typing dots, check the Fresha owner session is alive." vertex="1">
          <mxGeometry height="56" width="300" x="60" y="612" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Picture or attachment with no text?" vertex="1">
          <mxGeometry height="70" width="300" x="60" y="702" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Holding line &quot;give me a little time to have a think&quot;, hand over to Jess as a quote." vertex="1">
          <mxGeometry height="56" width="250" x="420" y="709" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Ask Claude (Opus 5.5). System prompt = persona (jess.md, voice-guide.md, vocabulary.md) + salon config (staff, services, prices, hours, booking links) + thread context. Tools on Fresha: check_availability, book_appointment, cancel_appointment, create_client, patch_test_status. Answer is JSON: reply, escalate, escalate_to (jess, lori-dee, carmen), area, escalation_kind, reason." vertex="1">
          <mxGeometry height="130" width="300" x="60" y="806" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Thread with Lori-Dee or Carmen, and this message is theirs?" vertex="1">
          <mxGeometry height="90" width="300" x="60" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#545B64;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Theirs to answer in the inbox. Store it, stay quiet; keep reading for nails or beauty." vertex="1">
          <mxGeometry height="56" width="250" x="420" y="987" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="escalate?" vertex="1">
          <mxGeometry height="60" width="300" x="60" y="1094" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#7AA116;fontColor=#232F3E;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" value="Record the turn, wait until about 10 s have passed since the message, send the reply through the Graph API." vertex="1">
          <mxGeometry height="56" width="250" x="420" y="1096" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" value="Locks the thread? complaint, quote, enquiry, cancellation fee, can&#39;t assist, no kind given, or anything hair" vertex="1">
          <mxGeometry height="110" width="300" x="60" y="1188" as="geometry" />
