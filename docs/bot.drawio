        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#545B64;fontColor=#232F3E;fontSize=11;align=center;" value="Telegram team group&lt;br&gt;one hand-over line per thread&lt;br&gt;for Jess, Lori-Dee and Carmen" vertex="1">
